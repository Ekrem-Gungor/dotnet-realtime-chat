{
  "ConnectionStrings": {
    "RealtimeChatConnection": "Server=localhost;Database=RealtimeChat;Trusted_Connection=True;TrustServerCertificate=True;",
    "AzureConnection": null
  },
  "JwtSettings": {
    "Issuer": "RealtimeChat.Api",
    "Audience": "RealtimeChat.Client",
    "SecretKey": "replace-with-a-random-secret-of-at-least-32-characters",
    "ExpireMinutes": 60
  },
  "Redis": "localhost:6379",
  "UICORSPath": "http://localhost:5173",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
